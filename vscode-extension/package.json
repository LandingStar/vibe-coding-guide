{
  "name": "doc-based-coding",
  "displayName": "Doc-Based Coding",
  "description": "VS Code Host UX extension for the Doc-Based Coding platform — consumes the shared MCP runtime to enforce constraints, manage pack topology, and provide AI-assisted governance.",
  "version": "0.2.1",
  "publisher": "doc-based-coding",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/doc-based-coding/vscode-extension"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "governance",
    "document-driven",
    "constraints",
    "MCP",
    "copilot"
  ],
  "activationEvents": [
    "workspaceContains:.codex/platform.json",
    "onChatParticipant:docBasedCoding.governance"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "docBasedCoding.governance",
        "fullName": "Doc-Based Coding Governance",
        "name": "governance",
        "description": "Ask about project constraints, check governance decisions, view packs, and get guidance on document-driven workflows.",
        "isSticky": false,
        "commands": [
          {
            "name": "check",
            "description": "Check current constraint status (C1-C8)"
          },
          {
            "name": "decide",
            "description": "Run governance decision on an action"
          },
          {
            "name": "constraints",
            "description": "View all constraint details"
          },
          {
            "name": "packs",
            "description": "List loaded packs"
          },
          {
            "name": "dogfood",
            "description": "Run dogfood evidence pipeline: evaluate symptoms, promote issues, generate feedback"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "doc-based-coding",
          "title": "Doc-Based Coding",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "doc-based-coding": [
        {
          "id": "aiChatView",
          "name": "AI Chat",
          "type": "webview"
        },
        {
          "id": "constraintDashboard",
          "name": "Constraints (C1-C8)"
        },
        {
          "id": "packExplorer",
          "name": "Pack Explorer"
        },
        {
          "id": "decisionLogViewer",
          "name": "Decision Log"
        },
        {
          "id": "configExplorer",
          "name": "Config Explorer"
        },
        {
          "id": "configPanel",
          "name": "Config Editor",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "docBasedCoding.refreshConstraints",
        "title": "Refresh Constraints",
        "icon": "$(refresh)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.startServer",
        "title": "Start MCP Server",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.stopServer",
        "title": "Stop MCP Server",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.openProgressGraphPreview",
        "title": "Open Progress Graph Preview",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.refreshProgressGraphPreview",
        "title": "Refresh Progress Graph Preview",
        "icon": "$(refresh)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.revealProgressGraphPreviewArtifact",
        "title": "Reveal Progress Graph Preview Artifact",
        "icon": "$(go-to-file)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.openMonitoringDashboard",
        "title": "Open Monitoring Dashboard",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.refreshMonitoringDashboard",
        "title": "Refresh Monitoring Dashboard",
        "icon": "$(refresh)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.setupWizard",
        "title": "Setup Wizard",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.refreshPacks",
        "title": "Refresh Packs",
        "icon": "$(refresh)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.refreshDecisionLogs",
        "title": "Refresh Decision Logs",
        "icon": "$(refresh)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.filterDecisionLogsMergeConflicts",
        "title": "Filter by Merge Conflicts",
        "icon": "$(filter)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.classifyIntent",
        "title": "Classify Intent (AI Model)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.generatePackDescription",
        "title": "Generate Pack Description (AI Model)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.generatePackRules",
        "title": "Generate Pack Rules (AI Model)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.openReviewPanel",
        "title": "Open Governance Review Panel",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.diagnose",
        "title": "Diagnose Connection",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.refreshConfig",
        "title": "Refresh Config",
        "icon": "$(refresh)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.editConfigItem",
        "title": "Edit Config Value",
        "icon": "$(edit)",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.selectModel",
        "title": "Select LLM Model",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.selectLLMProvider",
        "title": "Select LLM Provider",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.configureExternalApiKey",
        "title": "Configure External API Key",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.configureExternalApiBaseUrl",
        "title": "Configure External API Base URL",
        "category": "Doc-Based Coding"
      },
      {
        "command": "docBasedCoding.clearExternalApiKey",
        "title": "Clear External API Key",
        "category": "Doc-Based Coding"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "docBasedCoding.refreshConstraints",
          "when": "view == constraintDashboard",
          "group": "navigation"
        },
        {
          "command": "docBasedCoding.refreshPacks",
          "when": "view == packExplorer",
          "group": "navigation"
        },
        {
          "command": "docBasedCoding.refreshDecisionLogs",
          "when": "view == decisionLogViewer",
          "group": "navigation"
        },
        {
          "command": "docBasedCoding.filterDecisionLogsMergeConflicts",
          "when": "view == decisionLogViewer",
          "group": "navigation"
        },
        {
          "command": "docBasedCoding.refreshConfig",
          "when": "view == configExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "docBasedCoding.editConfigItem",
          "when": "view == configExplorer && viewItem == configEditable",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Doc-Based Coding",
      "properties": {
        "docBasedCoding.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python executable used for the MCP server. If empty, uses the workspace Python environment."
        },
        "docBasedCoding.sourceRoot": {
          "type": "string",
          "default": "",
          "description": "Optional source checkout root used for repo-local features such as progress graph artifact regeneration. If empty, the extension tries the workspace root first and then infers a repo root from docBasedCoding.pythonPath."
        },
        "docBasedCoding.serverMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "module",
            "command"
          ],
          "enumDescriptions": [
            "Auto-detect: try 'doc-based-coding-mcp' entry point first, fall back to 'python -m src.mcp.server'",
            "Use 'python -m src.mcp.server' (requires editable install or src/ in project)",
            "Use 'doc-based-coding-mcp' CLI entry point (requires pip install of .whl)"
          ],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments passed to the MCP server."
        },
        "docBasedCoding.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the MCP server when the extension activates."
        },
        "docBasedCoding.terminal.killOnBlock": {
          "type": "boolean",
          "default": false,
          "description": "Automatically kill terminal commands that are blocked by governance. When false, shows a warning with an option to kill manually."
        },
        "docBasedCoding.llm.family": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Language model family used for extension AI features (intent classification, pack generation, governance explanations). Current default provider: GitHub Copilot. Examples: gpt-4o, gpt-4o-mini, claude-3.5-sonnet, o1-preview."
        },
        "docBasedCoding.llm.provider": {
          "type": "string",
          "default": "copilot",
          "enum": [
            "copilot",
            "openai-compatible"
          ],
          "description": "LLM provider used by the extension AI surfaces. Use openai-compatible to call an external OpenAI-style API endpoint."
        },
        "docBasedCoding.llm.openaiCompatible.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for the external OpenAI-compatible API. Example: https://api.openai.com/v1 or your gateway base URL."
        },
        "docBasedCoding.llm.openaiCompatible.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model name sent to the external OpenAI-compatible API."
        },
        "docBasedCoding.monitoring.autoRefreshIntervalMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Auto-refresh interval in milliseconds for the monitoring dashboard. Range: 1000–60000ms."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src/",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:electron:smoke": "npm run build && node scripts/run-electron-webview-smoke.mjs",
    "provision:electron:vscode": "node scripts/provision-electron-vscode.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@note-web/knowledge-graph-engine": "file:vendor/note-web-knowledge-graph-engine-0.1.0.tgz",
    "@xyflow/react": "^12.11.0",
    "elkjs": "^0.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
